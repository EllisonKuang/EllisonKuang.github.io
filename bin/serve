#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export RUBYOPT="-r${repo_root}/_plugins/ruby_compat.rb${RUBYOPT:+ ${RUBYOPT}}"

if [ -x /opt/homebrew/opt/ruby/bin/bundle ]; then
  bundle_bin=/opt/homebrew/opt/ruby/bin/bundle
else
  bundle_bin=$(command -v bundle)
fi

exec "$bundle_bin" exec jekyll serve --livereload "$@"
